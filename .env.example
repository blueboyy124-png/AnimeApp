# ══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored (see .gitignore) and is the ONLY place these
# values should live. Never paste real keys back into a .ts/.tsx file:
# anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time and is readable by anyone via devtools -> Sources.
# ══════════════════════════════════════════════════════════════════════════

# ── TMDB ─────────────────────────────────────────────────────────────────
# Used by the home feed, detail pages, watch-page metadata enrichment and the
# kids-rating filter. Get one free at https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=

# ─ OMDb (optional) ──────────────────────────────────────────────────────
# Only used for the IMDb-rating badge on the /anime/[id] detail page. Leave
# blank to hide that badge; nothing else breaks.
NEXT_PUBLIC_OMDB_API_KEY=

# ── Supabase ─────────────────────────────────────────────────────────────
# Project settings -> API. The anon key is public by design; it is protected
# by row-level security, so make sure RLS is enabled on `accounts`,
# `profiles` and any other table before exposing this project publicly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Backends ─────────────────────────────────────────────────────────────
# Where the Next app should look for the two companion APIs. Defaults are
# baked into app/utils/api.ts for local/LAN use; set them explicitly when
# deploying somewhere the defaults don't apply. Inside the Electron shell
# these are ignored and 127.0.0.1 is used instead.
# NEXT_PUBLIC_API_URL=http://192.168.86.75:3000/api
# NEXT_PUBLIC_TMDB_EMBED_API_URL=http://192.168.86.75:8787

# ── Admin panel (SERVER-ONLY) ────────────────────────────────────────────
# No NEXT_PUBLIC_ prefix — these are read only inside route handlers and
# never reach the browser. There is deliberately NO default: if these are
# unset, /api/admin/* refuses every login rather than falling back to a
# guessable password.
#
# Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: pin the internal base URL used when one admin route verifies a
# session by calling /api/admin/auth back over HTTP. Leave unset and the
# incoming request's own origin is used, which is correct for local, LAN and
# Electron alike.
# ADMIN_INTERNAL_BASE_URL=

# ── Admin-managed service paths (SERVER-ONLY) ───────────────────────────
# Absolute paths the admin control route uses to start/stop the companion
# APIs. Unset means "this machine isn't managing them" and the related
# controls report as unavailable instead of guessing a path.
# ADMIN_BACKEND_PATH=
# ADMIN_TMDB_BACKEND_PATH=
# ADMIN_FRONTEND_PATH=
# ADMIN_TMDB_EMBED_API_URL=http://127.0.0.1:8787
# ADMIN_MIRURO_API_URL=http://127.0.0.1:3000